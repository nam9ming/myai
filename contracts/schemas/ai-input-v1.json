{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myai.invalid/contracts/ai-input-v1.json",
  "type": "object",
  "properties": {
    "data_kind": {
      "enum": [
        "synthetic",
        "real"
      ]
    },
    "document_version_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "published_date": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "block_id",
          "page",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "data_kind",
    "document_version_id",
    "title",
    "published_date",
    "blocks"
  ],
  "additionalProperties": false
}
